# Copy to .env:  cp .env.example .env
# Then start everything:  docker compose up --build

# ── App ──────────────────────────────────────────────
# Port the web app is published on (http://localhost:3000)
APP_PORT=3000

# Secret used to sign the session JWT cookie.
# Replace with a long random string, e.g.  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Set to true only when serving over HTTPS (marks the session cookie Secure).
COOKIE_SECURE=false

# Create the demo account (demo / demo1234) with sample data on first start.
SEED_DEMO_DATA=true

# ── Database (PostgreSQL 16 container) ───────────────
POSTGRES_USER=calenmate
POSTGRES_PASSWORD=calenmate
POSTGRES_DB=calenmate

# ── AI (external API, required for chat / summary / AI notes) ──
# Get a key at https://aistudio.google.com/app/apikey
# Without it the app still runs, but AI features return an error message.
GEMINI_API_KEY=
